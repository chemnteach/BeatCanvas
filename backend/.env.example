# BeatCanvas Environment Configuration
# Copy to .env and customize for your machine

# =============================================================================
# MACHINE-SPECIFIC PATHS (Your machine's "soul")
# =============================================================================

# SVD video output directory (absolute path)
SVD_OUTPUT_DIR=/home/craig/AI_Workspace/synterra/beatcanvas/backend/src/output

# Models directory (optional - if using local checkpoints)
# MODELS_DIR=/path/to/your/models

# LoRAs directory (optional)
# LORAS_DIR=/path/to/your/loras

# =============================================================================
# API KEYS (Or use global ~/.claude/.env)
# =============================================================================

# OpenAI (required for GPT-4, DALL-E 3)
# OPENAI_API_KEY=sk-...

# Google AI / Gemini (for Nano Banana image generation)
# GOOGLE_AI_API_KEY=...

# NovelAI (for artistic image generation)
# NOVELAI_API_KEY=...

# Replicate (for Stable Diffusion / Flux)
# REPLICATE_API_TOKEN=...

# RunPod (for hybrid WAN 2.6 + SkyReels V2 DF pipeline)
# Set to your RunPod pod proxy URL (e.g., https://abc123-8000.proxy.runpod.net)
# RUNPOD_ENDPOINT_URL=https://your-pod-id-8000.proxy.runpod.net
